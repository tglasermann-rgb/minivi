{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "regions": [
    "pdx1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 9 * * 0"
    }
  ]
}
