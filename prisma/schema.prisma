// MiniVi OS — modelo de datos (Fase 0)
// Ver docs/DATA-MODEL.md para el detalle y las fases siguientes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  kiosk
}

/// Perfil de usuario. `id` = auth.users.id de Supabase.
/// Se crea solo en el primer login (ver src/lib/auth.ts).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  role      Role     @default(kiosk)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@map("profiles")
}

/// Parámetros globales clave/valor. Los valores se guardan como texto
/// y se tipan en src/lib/settings.ts.
model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@map("settings")
}

/// Toda modificación de datos deja una fila acá (ver src/lib/audit.ts).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  userId    String?  @map("user_id") @db.Uuid
  userEmail String?  @map("user_email")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Fase 1 — Inventario
// ---------------------------------------------------------------------------

enum ProductType {
  necklace
  bracelet
  earring
  ring
  charm
  pendant
}

enum ProductStatus {
  draft
  active
  archived
}

enum StockReason {
  purchase
  sale
  return
  adjustment
  loss
  transfer
}

model Product {
  id                     String        @id @default(uuid()) @db.Uuid
  sku                    String        @unique
  /// Agrupa variantes de un mismo producto de Shopify (mismo handle = mismo producto).
  handle                 String
  title                  String
  type                   ProductType
  subcategory            String
  extraTags              String[]      @default([]) @map("extra_tags")
  karat                  String        @default("14k")
  grams                  Decimal       @db.Decimal(8, 2)
  descriptionHtml        String        @default("") @map("description_html")
  optionName             String?       @map("option_name")
  optionValue            String?       @map("option_value")
  costCents              Int           @map("cost_cents")
  priceCents             Int           @map("price_cents")
  priceOverride          Boolean       @default(false) @map("price_override")
  status                 ProductStatus @default(draft)
  shopifyProductId       String?       @map("shopify_product_id")
  shopifyVariantId       String?       @map("shopify_variant_id")
  shopifyInventoryItemId String?       @map("shopify_inventory_item_id")
  shopifySyncedAt        DateTime?     @map("shopify_synced_at") @db.Timestamptz(6)
  driveFolderId          String?       @map("drive_folder_id")
  barcode                String
  purchaseItemId         String?       @map("purchase_item_id") @db.Uuid
  notes                  String?
  images                 ProductImage[]
  movements              StockMovement[]
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?       @map("created_by") @db.Uuid

  @@index([type])
  @@index([status])
  @@index([handle])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id])
  driveFileId String?  @map("drive_file_id")
  fileName    String   @map("file_name")
  publicUrl   String   @map("public_url")
  position    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid

  @@unique([productId, fileName])
  @@map("product_images")
}

/// El stock actual de un producto es la suma de `qty`. Nunca se edita un campo de stock.
model StockMovement {
  id        String      @id @default(uuid()) @db.Uuid
  productId String      @map("product_id") @db.Uuid
  product   Product     @relation(fields: [productId], references: [id])
  qty       Int
  reason    StockReason
  reference String?
  note      String?
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?     @map("created_by") @db.Uuid

  @@index([productId])
  @@index([reason, createdAt])
  @@map("stock_movements")
}

/// Último número usado por tipo para generar SKUs sin colisiones.
model SkuCounter {
  type       String   @id
  lastNumber Int      @default(0) @map("last_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  @@map("sku_counters")
}

// ---------------------------------------------------------------------------
// Fase 2 — Compras
// ---------------------------------------------------------------------------

enum PurchaseStatus {
  draft
  ordered
  received
  closed
}

model Supplier {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  contact      String?
  paymentTerms String?    @map("payment_terms")
  notes        String?
  active       Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?    @map("created_by") @db.Uuid

  @@map("suppliers")
}

model Purchase {
  id               String         @id @default(uuid()) @db.Uuid
  number           Int            @unique @default(autoincrement())
  supplierId       String         @map("supplier_id") @db.Uuid
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  date             DateTime       @db.Date
  invoiceNumber    String?        @map("invoice_number")
  status           PurchaseStatus @default(draft)
  costPerGramCents Int            @map("cost_per_gram_cents")
  subtotalCents    Int            @default(0) @map("subtotal_cents")
  taxCents         Int            @default(0) @map("tax_cents")
  shippingCents    Int            @default(0) @map("shipping_cents")
  totalCents       Int            @default(0) @map("total_cents")
  /// contado | 30 | 30_60 | 30_60_90 | custom
  paymentTerms     String         @default("contado") @map("payment_terms")
  notes            String?
  /// [{ path, name, size }] en el bucket privado purchase-docs
  attachments      Json           @default("[]")
  items            PurchaseItem[]
  payables         Payable[]
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?        @map("created_by") @db.Uuid

  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               String      @id @default(uuid()) @db.Uuid
  purchaseId       String      @map("purchase_id") @db.Uuid
  purchase         Purchase    @relation(fields: [purchaseId], references: [id])
  position         Int         @default(1)
  description      String
  type             ProductType
  subcategory      String
  karat            String      @default("14k")
  grams            Decimal     @db.Decimal(8, 2)
  qty              Int
  qtyReceived      Int         @default(0) @map("qty_received")
  unitCostCents    Int         @map("unit_cost_cents")
  unitCostOverride Boolean     @default(false) @map("unit_cost_override")
  optionName       String?     @map("option_name")
  optionValue      String?     @map("option_value")
  productId        String?     @map("product_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?     @map("created_by") @db.Uuid

  @@index([purchaseId])
  @@map("purchase_items")
}

model Payable {
  id          String    @id @default(uuid()) @db.Uuid
  purchaseId  String    @map("purchase_id") @db.Uuid
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  amountCents Int       @map("amount_cents")
  dueOn       DateTime  @map("due_on") @db.Date
  paidOn      DateTime? @map("paid_on") @db.Date
  method      String?
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid

  @@index([dueOn])
  @@index([purchaseId])
  @@map("payables")
}
