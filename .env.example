# ---------------------------------------------------------------------------
# MiniVi OS — variables de entorno
# Copiar a .env.local (Next.js) y a .env (Prisma CLI). Ver docs/SETUP.md.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo servidor, nunca al navegador

# Supabase → Project Settings → Database → Connection string
# DATABASE_URL: pooler en modo transacción (puerto 6543), la usa la app.
# DIRECT_URL: conexión directa (puerto 5432), la usan las migraciones de Prisma.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Emails que reciben rol "owner" en su primer login (separados por coma).
# Cualquier otro usuario creado en Supabase entra como "kiosk".
OWNER_EMAILS=tomas@ejemplo.com,nissim@ejemplo.com
