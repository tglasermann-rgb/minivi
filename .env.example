# ---------------------------------------------------------------------------
# MiniVi OS — variables de entorno
# Copiar a .env.local (Next.js) y a .env (Prisma CLI). Ver docs/SETUP.md.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo servidor, nunca al navegador

# Supabase → Project Settings → Database → Connection string
# Usar la dirección "Session pooler" (puerto 5432) en las dos. DIRECT_URL es opcional.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres   # opcional: si falta se usa DATABASE_URL

# Emails que reciben rol "owner" en su primer login (separados por coma).
# Cualquier otro usuario creado en Supabase entra como "kiosk".
OWNER_EMAILS=tomas@ejemplo.com,nissim@ejemplo.com

# --- Fase 1: integraciones (opcionales hasta que se usen) ---
# Shopify: app custom del admin (docs/SETUP-SHOPIFY.md)
SHOPIFY_STORE_DOMAIN=minivi.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_...
SHOPIFY_API_VERSION=2026-01
# Secreto de los webhooks de Shopify (Settings → Notifications → Webhooks → "signed with")
SHOPIFY_WEBHOOK_SECRET=
# Protege /api/cron/* (Vercel lo manda solo en los crons). Cualquier texto largo al azar.
CRON_SECRET=
# Google Drive: JSON de la cuenta de servicio, en una sola línea o en base64 (docs/SETUP-DRIVE.md)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Fuente del precio del oro (JSON con "price" en USD/oz). Por defecto api.gold-api.com, gratis y sin clave.
GOLD_SPOT_URL=
